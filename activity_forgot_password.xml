<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:background="@color/screen_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forgot password?"
        android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_main"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter your email to begin recovery"
        android:textSize="15sp" android:textColor="@color/text_muted" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:padding="12dp" android:layout_marginBottom="10dp"
        android:hint="Email address" android:inputType="textEmailAddress" android:singleLine="true"
        android:backgroundTint="@color/primary" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/><Button android:id="@+id/btnContinue" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Continue" /><Button android:id="@+id/btnBackLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Back to login" />
</LinearLayout>