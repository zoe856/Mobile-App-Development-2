<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:background="@color/screen_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CampusConnect"
        android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_main"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your campus, connected."
        android:textSize="15sp" android:textColor="@color/text_muted" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎓" android:textSize="64sp" android:layout_marginBottom="20dp"/><Button android:id="@+id/btnGetStarted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Get Started" />
</LinearLayout>