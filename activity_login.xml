<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/screen_bg" android:padding="24dp">
    <LinearLayout android:id="@+id/content" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome back"
            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_main"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Login to continue"
            android:textSize="15sp" android:textColor="@color/text_muted" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:padding="12dp" android:layout_marginBottom="10dp"
        android:hint="Email or username" android:inputType="textEmailAddress" android:singleLine="true"
        android:backgroundTint="@color/primary" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/><EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:padding="12dp" android:layout_marginBottom="10dp"
        android:hint="Password" android:inputType="textPassword" android:singleLine="true"
        android:backgroundTint="@color/primary" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/><Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Login" /><Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Create account" /><Button android:id="@+id/btnForgot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Forgot password?" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>