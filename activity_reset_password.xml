<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:background="@color/screen_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset password"
        android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_main"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose a new password"
        android:textSize="15sp" android:textColor="@color/text_muted" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:padding="12dp" android:layout_marginBottom="10dp"
        android:hint="New password" android:inputType="textPassword" android:singleLine="true"
        android:backgroundTint="@color/primary" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/><EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:padding="12dp" android:layout_marginBottom="10dp"
        android:hint="Confirm new password" android:inputType="textPassword" android:singleLine="true"
        android:backgroundTint="@color/primary" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/><Button android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Save new password" /><Button android:id="@+id/btnBackLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="8dp" android:text="Back to login" />
</LinearLayout>